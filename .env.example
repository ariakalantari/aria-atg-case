# Claude mode (optional). Copy this file to .env and fill it in. Never commit .env.
# Without it the app runs in Local mode only, and the Claude switch is greyed out.

# Lines named AZURE_ANTHROPIC_API_KEY, AZURE_ANTHROPIC_ENDPOINT and AZURE_ANTHROPIC_DEPLOYMENT work too.

# The key of a Microsoft Foundry resource with a Claude Sonnet deployment
ANTHROPIC_FOUNDRY_API_KEY=
# The resource name: the part before .services.ai.azure.com in its endpoint
ANTHROPIC_FOUNDRY_RESOURCE=

# Optional: the deployment to use. Left empty, the app picks the newest Sonnet deployed
# (claude-sonnet-5-5, then claude-sonnet-5, then claude-sonnet-4-6).
CLAUDE_MODEL=
